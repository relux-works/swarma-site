---
import rows from '../data/status/layer-map.ru.json';
import StatusRow from './StatusRow.astro';
---
<div class="table-region" role="region" aria-label="Карта по слоям" tabindex="0">
  <table data-status-source="book-1.6.1">
    <caption>Карта по слоям</caption>
    <thead><tr><th scope="col">Слой и возможность</th><th scope="col">Работает сегодня</th><th scope="col">Чего ещё нет</th><th scope="col">Глава</th></tr></thead>
    <tbody>{rows.map(row => <StatusRow id={row.id} />)}</tbody>
  </table>
</div>
