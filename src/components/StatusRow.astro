---
import rows from '../data/status/layer-map.ru.json';
import parts from '../data/status/parts.ru.json';
import { statusKinds } from '../lib/status-render.mjs';
interface Props { id: string }
const row = rows.find(row => row.id === Astro.props.id);
const part = parts.find(row => row.id === Astro.props.id);
if (!row && !part) throw new Error(`unknown-status-id: ${Astro.props.id}`);
const kind = part && statusKinds[part.status];
---
{row ? <tr data-status-source="book-1.6.1" data-status-row={row.id}>
  <th scope="row">{row.capability}</th>
  <td>{row.works_today}</td>
  <td>{row.not_yet}</td>
  <td>{row.chapter}</td>
</tr> : part && <tr data-status-source="book-1.6.1" data-status-row={part.id}>
  <th scope="row">{part.part}</th>
  <td>{part.description}</td>
  <td>{kind ? <span class={`status-chip status-${kind}`}>{part.status}</span> : part.status}</td>
</tr>}
