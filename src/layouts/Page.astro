---
import { getCollection } from 'astro:content';
import { locales, localeLabels, route, type Locale } from '../lib/routes';
import '../styles/tokens.css';
import '../styles/site.css';

interface Props { title: string; description: string; lang: Locale; id?: string }
const { title, description, lang, id } = Astro.props;
const pages = await getCollection('pages');
const home = pages.find(page => page.id === `${lang}/index`);
const navigation = pages.filter(page => page.id.startsWith(`${lang}/`) && page.data.nav)
  .sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
const slug = id?.split('/').slice(1).join('/') ?? 'index';
const counterparts = locales.flatMap(locale => {
  const page = pages.find(page => page.id === `${locale}/${slug}`);
  return page ? [{ locale, page }] : [];
});
const labels = lang === 'ru'
  ? { skip: 'К содержимому', navigation: 'Основная навигация', languages: 'Язык' }
  : { skip: 'Skip to content', navigation: 'Main navigation', languages: 'Language' };
---
<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Swarma' ? title : `${title} | Swarma`}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">{labels.skip}</a>
    <header>
      <div class="container header-inner">
        <a class="wordmark" href={home ? route(home.id) : '/'}>Swarma</a>
        <nav aria-label={labels.navigation}>
          <ul>{navigation.map(page => <li><a href={route(page.id)} aria-current={id === page.id ? 'page' : undefined}>{page.data.title}</a></li>)}</ul>
        </nav>
        <nav aria-label={labels.languages}>
          <ul>{counterparts.map(({ locale, page }) => <li><a href={route(page.id)} lang={locale} hreflang={locale} aria-current={lang === locale ? 'page' : undefined}>{localeLabels[locale]}</a></li>)}</ul>
        </nav>
      </div>
    </header>
    <main id="main" class="container" tabindex="-1">
      <h1>{title}</h1>
      <slot />
    </main>
    <footer class="container"><bdi>Relux Works</bdi></footer>
  </body>
</html>
