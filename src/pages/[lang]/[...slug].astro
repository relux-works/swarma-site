---
import { getCollection, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import chapters from '../../data/book-chapters.json';
import type { Locale } from '../../lib/routes';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map(page => {
    const [lang, ...parts] = page.id.split('/');
    const slug = parts.join('/');
    return { params: { lang, slug: slug === 'index' ? undefined : slug }, props: { page, lang } };
  });
}
const { page, lang } = Astro.props;
const { Content } = await render(page);
---
<Page title={page.data.title} description={page.data.description} lang={lang as Locale} id={page.id}>
  <Content />
  {page.id === `${lang}/book` && <section class="book-chapters" aria-labelledby="book-contents">
    <h2 id="book-contents">{lang === 'en' ? 'Book chapters' : 'Главы книги'}</h2>
    <ol start="0">{chapters.map(chapter => <li id={`ch${chapter.number}`}><span class="technical">{chapter.number}</span> {lang === 'en' && chapter.title_en ? chapter.title_en : <span lang="ru">{chapter.title}</span>}</li>)}</ol>
  </section>}
</Page>
