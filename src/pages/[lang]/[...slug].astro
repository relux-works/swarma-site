---
import { getCollection, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { renderStatus } from '../../lib/status-render.mjs';
import chapters from '../../data/book-chapters.json';
import type { Locale } from '../../lib/routes';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map(page => {
    const [lang, ...parts] = page.id.split('/');
    const slug = parts.join('/');
    return { params: { lang, slug: slug === 'index' ? undefined : slug }, props: { page, lang } };
  });
}
const { page, lang } = Astro.props;
const { Content } = await render(page);
---
<Page title={page.data.title} description={page.data.description} lang={lang as Locale} id={page.id}>
  <Content />
  {page.id === 'ru/status' && !page.data.status_table && !page.data.status_rows && <>
    <p>Книга Swarma, версия 1.6.1, глава 30: Где мы и что дальше. Карта по слоям.</p>
    <Fragment set:html={renderStatus({ full: true })} />
  </>}
  {page.id === 'ru/book' && <section class="book-chapters" aria-labelledby="book-contents">
    <h2 id="book-contents">Главы книги</h2>
    <ol start="0">{chapters.map(chapter => <li id={`ch${chapter.number}`}><span class="technical">{chapter.number}</span> {chapter.title}</li>)}</ol>
  </section>}
</Page>
