{
  "name": "swarma-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run check:publication-surface && npm run check:status-data && npm run check:i18n",
    "build": "astro build",
    "test": "node --test scripts/checks/tests/*.test.mjs",
    "check": "npm run check:browser && npm test && npm run build && npm run check:publication-surface && npm run check:identifiers && npm run check:status-language && npm run check:names && npm run check:i18n && npm run check:status-data",
    "check:identifiers": "node scripts/checks/identifiers.mjs",
    "check:status-language": "node scripts/checks/status-language.mjs",
    "check:names": "node scripts/checks/names.mjs",
    "check:i18n": "node scripts/checks/i18n.mjs",
    "check:status-data": "node scripts/checks/status-data.mjs",
    "status:generate": "node scripts/checks/status-data.mjs --write",
    "check:publication-surface": "node scripts/checks/publication-surface.mjs",
    "check:browser": "node scripts/checks/browser-ready.mjs"
  },
  "dependencies": {
    "astro": "7.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "css-tree": "3.2.1",
    "gray-matter": "4.0.3",
    "markdown-it": "15.0.3",
    "parse5": "8.0.1",
    "playwright": "1.64.1",
    "postcss": "8.5.31"
  }
}
