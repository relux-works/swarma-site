{
  "name": "swarma-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/run.mjs --shell \"node node_modules/astro/bin/astro.mjs dev\"",
    "prebuild": "node scripts/run.mjs --shell \"npm run check:publication-surface && npm run check:no-status && npm run check:i18n && npm run check:brand\"",
    "build": "node scripts/run.mjs --shell \"node node_modules/astro/bin/astro.mjs build\"",
    "test": "node scripts/run.mjs --shell \"node --test --test-concurrency=4 scripts/checks/tests/*.test.mjs\"",
    "check": "node scripts/run.mjs --shell \"npm run check:browser && npm test && npm run build && npm run check:publication-surface && npm run check:identifiers && npm run check:status-language && npm run check:names && npm run check:i18n && npm run check:fonts && npm run check:contrast && npm run check:a11y && npm run check:header\"",
    "check:identifiers": "node scripts/run.mjs --shell \"node scripts/checks/identifiers.mjs\"",
    "check:status-language": "node scripts/run.mjs --shell \"node scripts/checks/status-language.mjs\"",
    "check:names": "node scripts/run.mjs --shell \"node scripts/checks/names.mjs\"",
    "check:i18n": "node scripts/run.mjs --shell \"node scripts/checks/i18n.mjs\"",
    "check:publication-surface": "node scripts/run.mjs --shell \"node scripts/checks/publication-surface.mjs\"",
    "check:contrast": "node scripts/run.mjs --shell \"node scripts/checks/contrast.mjs\"",
    "check:fonts": "node scripts/run.mjs --shell \"node scripts/checks/font-assets.mjs\"",
    "check:a11y": "node scripts/run.mjs --shell \"node scripts/checks/a11y.mjs\"",
    "postbuild": "node scripts/run.mjs --shell \"npm run check:figures && npm run check:no-status\"",
    "check:no-status": "node scripts/run.mjs --shell \"node scripts/checks/no-status.mjs\"",
    "check:brand": "node scripts/run.mjs --shell \"node scripts/checks/brand-assets.mjs\"",
    "check:figures": "node scripts/run.mjs --shell \"node scripts/checks/figure-publication.mjs\"",
    "check:header": "node scripts/run.mjs --shell \"node scripts/checks/a11y.mjs --geometry\"",
    "check:browser": "node scripts/run.mjs --shell \"node scripts/checks/browser-ready.mjs\""
  },
  "dependencies": {
    "astro": "7.4.2",
    "zod": "4.6.7",
    "@astrojs/markdown-remark": "7.3.4",
    "@fontsource/pt-mono": "5.3.0",
    "@fontsource/pt-sans": "5.3.0",
    "@fontsource/pt-serif": "5.3.0",
    "github-slugger": "2.0.0"
  },
  "devDependencies": {
    "css-tree": "3.2.1",
    "gray-matter": "4.0.3",
    "markdown-it": "15.0.3",
    "parse5": "8.0.1",
    "playwright": "1.64.1",
    "postcss": "8.5.31",
    "@axe-core/playwright": "4.14.0"
  }
}
